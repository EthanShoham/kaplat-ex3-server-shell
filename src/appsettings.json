{
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://localhost:8496"
      }
    }
  },
  "AllowedHosts": "*",
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File",
      "Serilog.Expressions",
      "ServerShellEx"
    ],
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft.AspNetCore": "Warning"
      }
    },
    "WriteTo": {
      "request-logger":
      {
        "Name": "Logger",
        "Args": {
          "configureLogger": {
            "MinimumLevel": {
              "Default": "Information"
            },
            "Filter": [
              {
                "Name": "ByIncludingOnly",
                "Args": {
                  "expression": "IsDefined(RequestNumber) and SourceContext = 'RequestLoggerMiddleware'"
                }
              }
            ],
            "WriteTo": [
              {
                "Name": "File",
                "Args": {
                  "path": "requests.log",
                  "outputTemplate": "{Timestamp:dd-MM-yyyy HH:mm:ss.fff} {CustomLevel}: {Message:lj} | request #{RequestNumber}{NewLine}"
                }
              },
              {
                "Name": "Console",
                "Args": {
                  "outputTemplate": "{Timestamp:dd-MM-yyyy HH:mm:ss.fff} {CustomLevel}: {Message:lj} | request #{RequestNumber}{NewLine}"
                }
              }
            ]
          }
        }
      },
      "stack-logger":
      {
        "Name": "Logger",
        "Args": {
          "configureLogger": {
            "MinimumLevel": {
              "Default": "Information"
            },
            "Filter": [
              {
                "Name": "ByIncludingOnly",
                "Args": {
                  "expression": "IsDefined(RequestNumber) and SourceContext <> 'RequestLoggerMiddleware' and (RequestPath like '/calculator/stack%' or Logger = 'stack-logger')"
                }
              }
            ],
            "WriteTo": [
              {
                "Name": "File",
                "Args": {
                  "path": "stack.log",
                  "outputTemplate": "{Timestamp:dd-MM-yyyy HH:mm:ss.fff} {CustomLevel}: {Message:lj} | request #{RequestNumber}{NewLine}{Exception}"
                }
              }
            ]
          }
        }
      },
      "independent-logger":
      {
        "Name": "Logger",
        "Args": {
          "configureLogger": {
            "MinimumLevel": {
              "Default": "Debug"
            },
            "Filter": [
              {
                "Name": "ByIncludingOnly",
                "Args": {
                  "expression": "IsDefined(RequestNumber) and SourceContext <> 'RequestLoggerMiddleware' and (RequestPath like '/calculator/independent%' or Logger = 'independent-logger')"
                }
              }
            ],
            "WriteTo": [
              {
                "Name": "File",
                "Args": {
                  "path": "independent.log",
                  "outputTemplate": "{Timestamp:dd-MM-yyyy HH:mm:ss.fff} {CustomLevel}: {Message:lj} | request #{RequestNumber}{NewLine}{Exception}"
                }
              }
            ]
          }
        }
      }
      },
    "Enrich": [
      "FromLogContext", "WithCustomLevel"
    ]
  }
}
