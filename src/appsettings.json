{
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://localhost:8496"
      }
    }
  },
  "AllowedHosts": "*",
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File",
      "Serilog.Expressions",
      "ServerShellEx"
    ],
    "MinimumLevel": {
      "Default": "Verbose",
      "Override": {
        "Microsoft":"Fatal",
        "System": "Fatal"
      }
    },
    "LevelSwitches": {
      "requestLogger": "Information",
      "stackLogger": "Information",
      "independentLogger": "Debug"
    },
    "WriteTo": [
      {
        "Name": "Logger",
        "Args": {
          "levelSwitch": "$requestLogger",
          "configureLogger": {
            "Filter": [
              {
                "Name": "ByIncludingOnly",
                "Args": {
                  "expression": "IsDefined(RequestNumber) and SourceContext = 'RequestLoggerMiddleware'"
                }
              }
            ],
            "WriteTo": [
              {
                "Name": "File",
                "Args": {
                  "path": "logs/requests.log",
                  "outputTemplate": "{Timestamp:dd-MM-yyyy HH:mm:ss.fff} {CustomLevel}: {Message:lj} | request #{RequestNumber}{NewLine}"
                }
              },
              {
                "Name": "Console",
                "Args": {
                  "outputTemplate": "{Timestamp:dd-MM-yyyy HH:mm:ss.fff} {CustomLevel}: {Message:lj} | request #{RequestNumber}{NewLine}"
                }
              }
            ]
          }
        }
      },
      {
        "Name": "Logger",
        "Args": {
          "levelSwitch": "$stackLogger",
          "configureLogger": {
            "Filter": [
              {
                "Name": "ByIncludingOnly",
                "Args": {
                  "expression": "IsDefined(RequestNumber) and SourceContext <> 'RequestLoggerMiddleware' and (RequestPath like '/calculator/stack%' or Logger = 'stack-logger')"
                }
              }
            ],
            "WriteTo": [
              {
                "Name": "File",
                "Args": {
                  "path": "logs/stack.log",
                  "outputTemplate": "{Timestamp:dd-MM-yyyy HH:mm:ss.fff} {CustomLevel}: {Message:lj} | request #{RequestNumber}{NewLine}"
                }
              }
            ]
          }
        }
      },
      {
        "Name": "Logger",
        "Args": {
          "levelSwitch": "$independentLogger",
          "configureLogger": {
            "Filter": [
              {
                "Name": "ByIncludingOnly",
                "Args": {
                  "expression": "IsDefined(RequestNumber) and SourceContext <> 'RequestLoggerMiddleware' and (RequestPath like '/calculator/independent%' or Logger = 'independent-logger')"
                }
              }
            ],
            "WriteTo": [
              {
                "Name": "File",
                "Args": {
                  "path": "logs/independent.log",
                  "outputTemplate": "{Timestamp:dd-MM-yyyy HH:mm:ss.fff} {CustomLevel}: {Message:lj} | request #{RequestNumber}{NewLine}"
                }
              }
            ]
          }
        }
      }
    ],
    "Enrich": [
      "FromLogContext", "WithCustomLevel"
    ]
  }
}
